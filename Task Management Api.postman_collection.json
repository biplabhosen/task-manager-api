    {
      "name": "All Tasks",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response is valid JSON', function () {",
              "    pm.response.to.be.json;",
              "});",
              "",
              "const contentTypeHeader = pm.response.headers.get('Content-Type');",
              "if (contentTypeHeader) {",
              "    pm.test('Content-Type header indicates JSON when present', function () {",
              "        pm.expect(contentTypeHeader.toLowerCase()).to.include('application/json');",
              "    });",
              "}",
              "",
              "const responseJson = pm.response.json();",
              "",
              "pm.test('Top-level response structure is valid', function () {",
              "    pm.expect(responseJson).to.be.an('object');",
              "    pm.expect(responseJson).to.have.property('success');",
              "    pm.expect(responseJson.success).to.be.a('boolean');",
              "    pm.expect(responseJson).to.have.property('message');",
              "    pm.expect(responseJson.message).to.be.a('string').and.not.empty;",
              "    pm.expect(responseJson).to.have.property('data');",
              "    pm.expect(responseJson.data).to.be.an('array');",
              "});",
              "",
              "pm.test('Success flag is true', function () {",
              "    pm.expect(responseJson.success).to.eql(true);",
              "});",
              "",
              "pm.test('Message field is present and meaningful', function () {",
              "    pm.expect(responseJson.message).to.be.a('string');",
              "    pm.expect(responseJson.message.trim().length).to.be.greaterThan(0);",
              "});",
              "",
              "pm.test('Data is an array', function () {",
              "    pm.expect(responseJson.data).to.be.an('array');",
              "});",
              "",
              "const requestedStatus = pm.request.url.query.get('status') || 'completed';",
              "",
              "pm.test('Requested status query param is completed', function () {",
              "    pm.expect(requestedStatus).to.eql('completed');",
              "});",
              "",
              "responseJson.data.forEach(function (task, index) {",
              "    pm.test(`Task at index ${index} has expected fields`, function () {",
              "        pm.expect(task).to.be.an('object');",
              "        pm.expect(task).to.have.property('id');",
              "        pm.expect(task.id).to.satisfy(function (value) {",
              "            return typeof value === 'number' || typeof value === 'string';",
              "        });",
              "        pm.expect(task).to.have.property('title');",
              "        pm.expect(task.title).to.be.a('string');",
              "        pm.expect(task).to.have.property('description');",
              "        pm.expect(task.description === null || typeof task.description === 'string').to.eql(true);",
              "        pm.expect(task).to.have.property('status');",
              "        pm.expect(task.status).to.be.a('string');",
              "        pm.expect(task).to.have.property('due_date');",
              "        pm.expect(task.due_date === null || typeof task.due_date === 'string').to.eql(true);",
              "        pm.expect(task).to.have.property('created_at');",
              "        pm.expect(task.created_at).to.be.a('string');",
              "        pm.expect(task).to.have.property('updated_at');",
              "        pm.expect(task.updated_at).to.be.a('string');",
              "    });",
              "",
              "    pm.test(`Task at index ${index} matches requested status`, function () {",
              "        pm.expect(task.status).to.eql(requestedStatus);",
              "    });",
              "});",
              "",
              "if (responseJson.meta !== undefined) {",
              "    pm.test('Meta field is an object when present', function () {",
              "        pm.expect(responseJson.meta).to.be.an('object');",
              "    });",
              "",
              "    pm.test('Pagination/meta fields are valid when present', function () {",
              "        pm.expect(responseJson.meta).to.have.property('current_page');",
              "        pm.expect(responseJson.meta.current_page).to.be.a('number');",
              "        pm.expect(responseJson.meta).to.have.property('last_page');",
              "        pm.expect(responseJson.meta.last_page).to.be.a('number');",
              "        pm.expect(responseJson.meta).to.have.property('per_page');",
              "        pm.expect(responseJson.meta.per_page).to.be.a('number');",
              "        pm.expect(responseJson.meta).to.have.property('total');",
              "        pm.expect(responseJson.meta.total).to.be.a('number');",
              "    });",
              "",
              "    pm.test('Meta pagination values are internally consistent', function () {",
              "        pm.expect(responseJson.meta.current_page).to.be.at.least(1);",
              "        pm.expect(responseJson.meta.last_page).to.be.at.least(responseJson.meta.current_page);",
              "        pm.expect(responseJson.meta.per_page).to.be.greaterThan(0);",
              "        pm.expect(responseJson.meta.total).to.be.at.least(responseJson.data.length);",
              "    });",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
